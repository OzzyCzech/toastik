{
	"name": "toastik",
	"version": "0.1.20",
	"description": "A lightweight, dependency-free toast notification component for Vue 3 with Tailwind 4 styling.",
	"type": "module",
	"license": "MIT",
	"author": "Roman Ožana <roman@ozana.cz>",
	"homepage": "https://github.com/OzzyCzech/toastik",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/toastik.git"
	},
	"keywords": [
		"vue",
		"vue3",
		"toast",
		"notification",
		"tailwind",
		"tailwindcss",
		"snackbar"
	],
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/toastik.css"
	},
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"build:demo": "npm run build && vite build --config vite.demo.config.ts",
		"type-check": "vue-tsc --noEmit",
		"preview": "vite preview"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/language-core": "^3.3.4",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vue": "^3.5.35",
		"vue-tsc": "^3.3.4"
	}
}
